# Copy this file to .env for local Docker Compose development.
# Values are synthetic local-only defaults. Never commit a populated .env file.

JOB_ENGINE_POSTGRES_DB=job_engine
JOB_ENGINE_POSTGRES_USER=postgres
JOB_ENGINE_POSTGRES_PASSWORD=change-me-local-only
JOB_ENGINE_MCP_PORT=8080
# Local source-build image only. scripts/run-release-mcp-http.sh overrides this with its chosen published tag or digest.
MCP_IMAGE=job-engine-spring:local

# Privileged local operator HTTP boundary (/api/operator/v1/**, /operator/**).
# Disabled by default; every operator route answers 404 while this is false.
# Enable only on a trusted local machine, and set a private token of at least
# 32 characters (for example: openssl rand -base64 48). Enabling with a shorter
# token fails startup. Never commit a populated token.
JOB_ENGINE_OPERATOR_ENABLED=false
JOB_ENGINE_OPERATOR_BEARER_TOKEN=
